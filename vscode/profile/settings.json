{
    // Editor
    "editor.bracketPairColorization.enabled": true,
    "editor.cursorBlinking": "solid",
    "editor.cursorWidth": 0,
    "editor.fontFamily": "JetBrains Mono, Fira Code, Operator Mono, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "none",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.markdownlint": "always"
    },
    "editor.linkedEditing": true, // no need for the extension auto rename tag
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    //Terminal
    "terminal.integrated.fontFamily": "Fira Code, Operator Mono,f Menlo, Monaco, 'Courier New', monospace",
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.explorerKind": "external",
    // Prettier
    "[javascript][typescript][typescriptreact][html][javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        // "editor.formatOnPaste": true, // required
        // "editor.formatOnType": false, // required
        "editor.formatOnSave": true, // optional
        // "editor.formatOnSaveMode": "file", // required to format on save
        // "files.autoSave": "onFocusChange" // optional but recommended
    },
    "workbench.iconTheme": "material-icon-theme",
    // Unlabeled
    "git.mergeEditor": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
    },
    // no need for the extension auto import
    "js/ts.suggest.autoImports": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    // auto trim
    "files.trimTrailingWhitespace": true,
    "[markdown]": {
        "files.trimTrailingWhitespace": false,
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true
    },
    "js/ts.inlayHints.parameterNames.enabled": "literals",
    "javascript.inlayHints.enumMemberValues.enabled": true,
    "typecript.inlayHints.enumMemberValues.enabled": true,
    "explorer.confirmDelete": false,
    "explorer.confirmPasteNative": false,
    "explorer.confirmDragAndDrop": false,
    // "[jsonc]": {
    //     "editor.defaultFormatter": "vscode.json-language-features"
    // },
    "emmet.includeLanguages": {
        "typescript": "typescriptreact",
        "javascript": "javascriptreact"
    },
    "editor.accessibilitySupport": "off",
    "prettier.tabWidth": 4,
    "workbench.colorTheme": "New Moon",
    "chat.viewSessions.orientation": "stacked",
    "chat.tools.terminal.autoApprove": {
        "/^pnpm --filter @personal-apps/app typecheck$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^pnpm --filter @personal-apps/app build$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
}