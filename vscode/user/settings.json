{
  // Editor
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono, Fira Code, Operator Mono, Menlo, Monaco, 'Courier New', monospace",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "solid",
  "editor.cursorWidth": 2,
  // "editor.cursorStyle": "line",
  // "editor.autoClosingBrackets": "always",

  // start prettier
  "[javascript][typescript][typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": true, // required
    "editor.formatOnType": false, // required
    "editor.formatOnSave": true, // optional
    "editor.formatOnSaveMode": "file", // required to format on save
    "files.autoSave": "onFocusChange" // optional but recommended
  },
  // end prettier

  //Terminal
  "terminal.integrated.fontFamily": "Fira Code, Operator Mono, Menlo, Monaco, 'Courier New', monospace",
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.altClickMovesCursor": false,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.explorerKind": "external",
  "terminal.external.osxExec": "iterm.app",

  // Explorer
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,

  // Unlabeled
  "security.workspace.trust.untrustedFiles": "open",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "debug.toolBarLocation": "docked",
  "git.mergeEditor": true,
  "workbench.iconTheme": "vscode-great-icons",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "fit",

  "workbench.colorCustomizations": {
    // "editor.lineHighlightBackground": "#313741",
    "editor.lineHighlightBorder": "#282c34",
    "[doom-one]": {
      "statusBar.debuggingBackground": "#2257A0"
    }
  },
  "typeChallenges.workspaceFolder": "/Users/paulopereira/.typeChallenges",
  "workbench.colorTheme": "Default Dark+",
  "git.openRepositoryInParentFolders": "never",
  "window.newWindowProfile": "React",
}